#!/usr/bin/env python3

"""
Created on 15 Nov 2026

@author: Bruno Beloff (bbeloff@me.com)

source repo: mrcs_control

DESCRIPTION
A service that manages alert messages.

The service begins by publishing the unresolved alerts from its database table.

A --drain function is available - this drains the queue used by mrcs_control_alert_service before any other functions
are invoked. The function is useful if problematic messages have been published to the queue.

Note that in --run mode, the utility runs until it receives a SIGINT.

SYNOPSIS
mrcs_control_alert_service [-h] [-i INDENT] [-v] [--version] [-t] [-d] [-c] (-lu | -r)

EXAMPLES
mrcs_control_alert_service -v -i4 -lu
mrcs_control_alert_service -v -c -d -r

TEST WITH
mrcs_control_publisher -v -r ALR.*.1 -m '{"type": "Alert", "id": null, "severity": "HIGH", "impact": "GLOBAL", \
"subject": "TRACK", "text": "short happened", "raised": "2026-11-15T08:43:56.970+00:00", "resolved": null}'

mrcs_control_subscriber -v -s ALR.*.002

SEE ALSO
mrcs_control_alert_client
"""

import sys

from mrcs_control.cli.args.alert_service_args import AlertServiceArgs
from mrcs_control.operations.alert.alert_node import AlertNode
from mrcs_core.data.json import JSONify
from mrcs_core.sys.logging import Logging


# --------------------------------------------------------------------------------------------------------------------

def control_alert_on_message(message):
    print(JSONify.dumps(message, indent=args.indent))


# --------------------------------------------------------------------------------------------------------------------

if __name__ == '__main__':

    node = None

    # ----------------------------------------------------------------------------------------------------------------

    args = AlertServiceArgs('a service that manages alert messages')

    Logging.config('mrcs_control_alert_service', verbose=args.verbose)  # verbose=args.verbose / level=logging.DEBUG
    logger = Logging.getLogger()
    logger.info(f'args: {args}')
    logger.info(f'mode: {args.mode.value}')

    message_handler = control_alert_on_message if args.verbose else None

    # ----------------------------------------------------------------------------------------------------------------

    try:
        node = AlertNode(args.mode.value, on_message=message_handler)

        if args.drain:
            purged_count = node.drain()
            if purged_count is not None:
                logger.info(f'drained message count: {purged_count}')

        if args.clear:
            node.clear()

        if args.list_unresolved:
            alerts = node.list_unresolved()
            print(JSONify.dumps(alerts, indent=args.indent))

        if args.run:
            node.run()


    # ----------------------------------------------------------------------------------------------------------------

    except KeyboardInterrupt:
        pass

    finally:
        if args.run:
            print(file=sys.stderr)

        if node is not None:
            node.close()
