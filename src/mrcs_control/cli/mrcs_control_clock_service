#!/usr/bin/env python3

"""
Created on 17 Jan 2026

@author: Bruno Beloff (bbeloff@me.com)

source repo: mrcs_control

DESCRIPTION
A service to manage the model time clock configuration

A --drain function is available - this drains the queue used by mrcs_control_clock_service before any other functions
are invoked. The function is useful if problematic messages have been published to the queue.

Note that in --subscribe mode, the utility runs until it receives a SIGINT.

SYNOPSIS
mrcs_control_clock_service [-h] [-i INDENT] [-v] [--version] [-t] [-d] (-c | -n | -s)

EXAMPLES
mrcs_control_clock_service --verbose --subscribe --test

FILES
~/MRCS/conf/clock_conf.json

SEE ALSO
mrcs_control_cron_service
mrcs_control_crontab_service
"""

import sys

from mrcs_control.cli.args.clock_service_args import ClockServiceArgs
from mrcs_control.operations.time.clock_manager_node import ClockManagerNode
from mrcs_core.data.json import JSONify
from mrcs_core.operations.time.clock import Clock
from mrcs_core.sys.host import Host
from mrcs_core.sys.logging import Logging


# --------------------------------------------------------------------------------------------------------------------

if __name__ == '__main__':

    node = None

    # ----------------------------------------------------------------------------------------------------------------

    args = ClockServiceArgs('a service to manage the model time clock configuration')

    Logging.config('mrcs_control_clock_service', verbose=args.verbose)
    logger = Logging.getLogger()
    logger.info(f'args: {args}')
    logger.info(f'mode: {args.mode.value}')

    # ----------------------------------------------------------------------------------------------------------------

    try:
        node = ClockManagerNode(args.mode.value)

        if args.drain:
            node.drain()

        if args.conf:
            conf = Clock.load(Host)
            print(JSONify.dumps(conf))
            exit(0)

        if args.now:
            conf = Clock.load(Host)
            print(JSONify.dumps(conf.now()))
            exit(0)

        if args.subscribe:
            node.subscribe()


    # ----------------------------------------------------------------------------------------------------------------

    except KeyboardInterrupt:
        print(file=sys.stderr)

    finally:
        if node is not None:
            node.close()
