#!/usr/bin/env python3

"""
Created on 13 Sep 2026

@author: Bruno Beloff (bbeloff@me.com)

source repo: mrcs_control

DESCRIPTION
A utility for navigating layouts. Functions:
* --list - list all the layouts
* --set-selected-layout - if there is only one layout, then this is not needed
* --block-inventory - list the BlockStatus records - these are used to populate the database
* --turnout-inventory - list the TurnoutStatus records - these are used to populate the database
* --block-view - display the selected block and segments. If no location is specified, all blocks are shown
* --station-view - display the selected station and platforms. If no location is specified, all stations are shown
* --segment-route - show the route (if available) from the start segment to the end segment
* --platform-route - show the route (if available) from the start platform to the end platform

Notes:
The --block-view and --station-view flags take optional dot-path identifiers, indicating a specific location,
broader location, or the whole component group.

The --segment-route and --platform-route flags take pairs of compulsory dot-path identifiers, indicating
fully-specified locations.

For --segment-route and --platform-route the utility requires the backend services to be running in order to
determine the layout's current turnout positions.

SYNOPSIS
usage: mrcs_control_layout [-h] [-i INDENT] [-v] [--version] [-t] (-l | -sl LAYOUT | -bi | -ti | -bv [BLK[.SEG]] |
-sv [STN[.PLT]] | -sr HEADING BLK1.SEG1 BLK2.SEG2 | -pr HEADING STN1.PLT1 STN2.PLT2)

EXAMPLES
mrcs_control_layout -v -i4 -l
mrcs_control_layout -v -i4 -bv BS02
mrcs_control_layout -v -i4 -sv Beta
mrcs_control_layout -v -i4 -sr UP BS01.SG01 BS07.SG01
mrcs_control_layout -v -i4 -pr UP Alpha.1 Beta.1
"""

import sys

from mrcs_control.cli.args.layout_args import LayoutArgs
from mrcs_control.cli.internal.turnout_configuration_finder import TurnoutConfigurationFinder
from mrcs_core.data.equipment_identity import EquipmentIdentifier, EquipmentType
from mrcs_core.data.json import JSONify
from mrcs_core.inventory.layout.layout import Layout
from mrcs_core.inventory.layout.layout_conf import LayoutConf
from mrcs_core.sys.host import Host
from mrcs_core.sys.logging import Logging


# --------------------------------------------------------------------------------------------------------------------

if __name__ == '__main__':

    layout = None
    config = None
    path = None

    # ----------------------------------------------------------------------------------------------------------------

    args = LayoutArgs('a utility for navigating layouts')

    Logging.config('mrcs_control_layout', verbose=args.verbose)  # verbose=args.verbose / level=logging.DEBUG
    logger = Logging.getLogger()
    logger.info(f'args: {args}')

    this_id = EquipmentIdentifier(EquipmentType.TST, None, 2)

    # ----------------------------------------------------------------------------------------------------------------

    if args.list:
        layouts = Layout.list(Host)
        print(JSONify.dumps(layouts, indent=args.indent))
        exit(0)

    if args.set_selected_layout:
        if args.set_selected_layout not in Layout.list(Host):
            logger.error(f'Layout {args.set_selected_layout} is not known.')
            exit(2)

        conf = LayoutConf(args.set_selected_layout)
        conf.save(Host)
        exit(0)

    # ----------------------------------------------------------------------------------------------------------------

    try:
        layout = LayoutConf.load_selected_layout(Host)
    except Exception as exc:
        logger.error(f'{exc.__class__.__name__} in layout component {exc}')
        exit(2)

    if layout is None:
        logger.error(f'No layout is selected. Use mrcs_control_layout --set-selected-layout to set one.')
        exit(1)

    logger.info(f'layout: {layout.label}')

    # ----------------------------------------------------------------------------------------------------------------

    if args.block_inventory:
        inventory = layout.block_inventory()
        print(JSONify.dumps(inventory, indent=args.indent))
        exit(0)

    if args.turnout_inventory:
        inventory = layout.turnout_inventory()
        print(JSONify.dumps(inventory, indent=args.indent))
        exit(0)

    # ----------------------------------------------------------------------------------------------------------------

    if args.block_view:
        try:
            blocks = layout.block_report(args.view_node_block, args.view_node_segment)
        except KeyError as exc:
            logger.error(f'The node {exc.args[0]} could not be found.')
            exit(2)

        print(JSONify.dumps(blocks, indent=args.indent))
        exit(0)

    if args.station_view:
        try:
            stations = layout.station_report(args.view_node_station, args.view_node_platform)
        except KeyError as exc:
            logger.error(f'The node {exc.args[0]} could not be found.')
            exit(2)

        print(JSONify.dumps(stations, indent=args.indent))
        exit(0)

    # ----------------------------------------------------------------------------------------------------------------

    try:
        layout.validate()
    except Exception as exc:
        logger.error(exc)
        exit(1)

    finder = TurnoutConfigurationFinder(this_id)
    config = finder.find(args.mode.value)

    if args.segment_route:
        locations = layout.segment_locations

        if args.segment_route_start not in locations:
            logger.error(f'The start segment {args.segment_route_start.dot_path} is not in the layout.')
            exit(2)

        if args.segment_route_end not in locations:
            logger.error(f'The end segment {args.segment_route_end.dot_path} is not in the layout.')
            exit(2)

        try:
            path = layout.segment_route(config, args.route_heading, args.segment_route_start, args.segment_route_end)
        except ValueError as exc:
            print(exc, file=sys.stderr)
            exit(1)

    if args.platform_route:
        locations = layout.platform_locations

        if args.platform_route_start not in locations:
            logger.error(f'The start platform {args.platform_route_start.dot_path} is not in the layout.')
            exit(2)

        if args.platform_route_end not in locations:
            logger.error(f'The end platform {args.platform_route_end.dot_path} is not in the layout.')
            exit(2)

        try:
            path = layout.platform_route(config, args.route_heading, args.platform_route_start, args.platform_route_end)
        except ValueError as exc:
            print(exc, file=sys.stderr)
            exit(1)

    if path is not None:
        print(JSONify.dumps(path, indent=args.indent))
        # noinspection unresolved-references
        logger.info(f'total length: {path.total_length}')
